table DimGDP
	lineageTag: b6e235c6-6e47-492f-ba5a-7c27edaabb7c
	sourceLineageTag: [gold].[DimGDP]

	measure US_GDP_USD = SUMX(VALUES(DimDate[year]), VAR CurrentYear = DimDate[year] RETURN CALCULATE(AVERAGE(DimGDP[gdp_usd]), REMOVEFILTERS(DimGDP), DimGDP[country_iso3] = "USA", DimGDP[year] = CurrentYear))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
