table FactTaxiDaily
	lineageTag: 1bc2e125-85ee-45ac-a854-dda9c8a8a20f
	sourceLineageTag: [gold].[FactTaxiDaily]

	measure TotalTrips = SUM(FactTaxiDaily[trip_count])
		formatString: 0
		lineageTag: 4cd56655-9dd6-471b-b144-51d7a1784fbc

		changedProperty = Name

		changedProperty = IsHidden

	measure AvgDailyTrips = AVERAGEX(VALUES(DimDate[date]), [TotalTrips])
		lineageTag: 96e40772-36a7-4f0e-a174-b00a4d80f879

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalRevenueUSD = SUM(FactTaxiDaily[total_revenue_usd])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 9147187e-0831-4faa-9e48-0e47d363e91d

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure AvgFareUSD = DIVIDE(SUM(FactTaxiDaily[total_revenue_usd]), SUM(FactTaxiDaily[clean_fare_trip_count]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 970e41a2-78e8-4989-a7bf-d568e3d05567

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure AvgDistance = DIVIDE(SUM(FactTaxiDaily[total_distance_miles]),SUM(FactTaxiDaily[measured_distance_trip_count]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 3e637a33-3970-4dda-b32b-9cbf62ae3538

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure TotalDropoffTrips = CALCULATE([TotalTrips], USERELATIONSHIP(DimZone[zone_key], FactTaxiDaily[dropoff_zone_key]))
		formatString: 0
		lineageTag: 92520b34-b9ad-4f02-b572-05cc6beec7ad

		changedProperty = Name

	measure TotalRevenueEUR = SUMX(FactTaxiDaily, FactTaxiDaily[total_revenue_usd] * RELATED(DimFX[usd_to_eur_rate]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 4164d2e6-39f8-423e-bd39-3a5dae0b0d71

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure AvgFareEUR = DIVIDE([TotalRevenueEUR], SUM(FactTaxiDaily[clean_fare_trip_count]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 0a65973e-490a-464e-9d77-5e3c174bd0aa

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure TaxiRevenuePartOfUSGDP = DIVIDE([TotalRevenueUSD], [US_GDP_USD])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 8ad9996f-f0ed-4812-a792-617eefd8f55d

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

